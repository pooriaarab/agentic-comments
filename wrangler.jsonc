{
  // Auth is agentic-identity: principals and credentials live in the D1 database (issue them with issueCredential).
  // A static token list is a dev fallback: set the secret AGENTIC_COMMENTS_TOKENS and AGENTIC_COMMENTS_UNSAFE_STATIC_TOKENS=1. Never in production.
  // Also set the region claim: wrangler secret put AGENTIC_COMMENTS_REGION  (the value is "eu" or "us").
  "name": "agentic-comments",
  "main": "dist/worker.js",
  // Create the database with `wrangler d1 create agentic-comments --location weur`, then put its id below.
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "agentic-comments", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
