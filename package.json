{
  "name": "agentic-comments",
  "version": "0.1.0",
  "description": "Comment threads and suggestions anchored to any content, from people and agents.",
  "keywords": [
    "comments",
    "threads",
    "mentions",
    "suggestions",
    "annotations",
    "collaboration",
    "agents",
    "yjs"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "homepage": "https://github.com/pooriaarab/agentic-comments#readme",
  "bugs": {
    "url": "https://github.com/pooriaarab/agentic-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-comments.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
