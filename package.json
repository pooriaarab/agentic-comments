{
  "name": "agentic-comments",
  "version": "0.8.3",
  "description": "Comment threads and suggestions anchored to any content, from people and agents.",
  "keywords": [
    "comments",
    "threads",
    "mentions",
    "suggestions",
    "annotations",
    "collaboration",
    "agents",
    "yjs",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "homepage": "https://github.com/pooriaarab/agentic-comments#readme",
  "bugs": {
    "url": "https://github.com/pooriaarab/agentic-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-comments.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-comments",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./anchor": {
      "types": "./dist/anchoring.d.ts",
      "import": "./dist/anchoring.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "bin": {
    "agentic-comments": "./dist/cli.js",
    "agentic-comments-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "test": "vitest run",
    "deploy:demo": "npm run build && npm run build:ui && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "clean": "rm -rf dist",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --port 8794",
    "dev:smoke": "npm run build && node scripts/dev-smoke.mjs 8794 /health",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "test:ui": "npm run build && npm run build:ui && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agentic-design": "^0.5.0",
    "agentic-identity": "^0.9.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ]
}
