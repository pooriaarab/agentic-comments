{
  "name": "agentic-comments",
  "version": "0.0.0",
  "description": "Comment threads and suggestions anchored to any content, from people and agents.",
  "keywords": [
    "comments",
    "threads",
    "mentions",
    "suggestions",
    "annotations",
    "collaboration",
    "agents",
    "yjs",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-comments.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yjs": "^13.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "mcpName": "io.github.pooriaarab/agentic-comments",
  "bin": {
    "agentic-comments": "./dist/cli.js",
    "agentic-comments-mcp": "./dist/mcp-bin.js"
  }
}
